DEF[name_in,FN[[xs,name,i],
  IF[GE[i,LEN[xs]],
    false,
    IF[EQ[AT[xs,i],name],
      true,
      name_in[xs,name,ADD[i,1]]
    ]
  ]
]]

DEF[mod_file,FN[[dir,name],
  CONCAT[CONCAT[dir,'/'],CONCAT[name,'.knot']]
]]

DEF[import_mod,FN[[im],
  AT[PAYLOAD[im],0]
]]

DEF[load_module_items,FN[[dir,name],
  MATCH[parse[lex[STRING_FROM_BYTES[FS_READ[mod_file[dir,name]]]]],
    CASE[Prog,items,SUM['Ok',items]],
    CASE[Err,e,SUM['Err',e]]
  ]
]]

DEF[expand_imports,FN[[dir,items,i,acc,seen],
  IF[GE[i,LEN[items]],
    SUM['Ok',acc],
    IF[EQ[TAG[AT[items,i]],'Import'],
      IF[name_in[seen,import_mod[AT[items,i]],0],
        expand_imports[dir,items,ADD[i,1],acc,seen],
        MATCH[load_module_items[dir,import_mod[AT[items,i]]],
          CASE[Ok,mod_items,
            MATCH[expand_imports[dir,mod_items,0,LIST[],APPEND[seen,import_mod[AT[items,i]]]],
              CASE[Ok,expanded,
                expand_imports[dir,items,ADD[i,1],CONCAT[acc,expanded],APPEND[seen,import_mod[AT[items,i]]]]
              ]
            ]
          ],
          CASE[Err,e,SUM['Err',e]]
        ]
      ],
      expand_imports[dir,items,ADD[i,1],APPEND[acc,AT[items,i]],seen]
    ]
  ]
]]

DEF[compile_items,FN[[items],
  IF[check_ok[SUM['Prog',items]],
    compile_ast[SUM['Prog',items]],
    SUM['Err','check_failed']
  ]
]]

DEF[compile_source,FN[[s:string],
  MATCH[parse[lex[s]],
    CASE[Prog,items,compile_items[items]],
    CASE[Err,e,SUM['Err',e]]
  ]
]]

DEF[compile_path,FN[[path:string],
  compile_source[STRING_FROM_BYTES[FS_READ[path]]]
]]

DEF[compile_root,FN[[dir:string,root:string],
  MATCH[parse[lex[STRING_FROM_BYTES[FS_READ[CONCAT[CONCAT[dir,'/'],root]]]]],
    CASE[Prog,items,
      MATCH[expand_imports[dir,items,0,LIST[],LIST[]],
        CASE[Ok,all,compile_items[all]],
        CASE[Err,e,SUM['Err',e]]
      ]
    ],
    CASE[Err,e,SUM['Err',e]]
  ]
]]
