DEF[op_load_const,FN[[],1]]
DEF[op_load_local,FN[[],2]]
DEF[op_store_local,FN[[],3]]
DEF[op_add,FN[[],10]]
DEF[op_sub,FN[[],11]]
DEF[op_mul,FN[[],12]]
DEF[op_div,FN[[],13]]
DEF[op_mod,FN[[],14]]
DEF[op_neg,FN[[],15]]
DEF[op_eq,FN[[],20]]
DEF[op_ne,FN[[],21]]
DEF[op_lt,FN[[],22]]
DEF[op_le,FN[[],23]]
DEF[op_gt,FN[[],24]]
DEF[op_ge,FN[[],25]]
DEF[op_not,FN[[],26]]
DEF[op_jump,FN[[],30]]
DEF[op_jump_if_false,FN[[],31]]
DEF[op_call,FN[[],40]]
DEF[op_return,FN[[],41]]
DEF[op_native,FN[[],70]]
DEF[op_hole_trap,FN[[],60]]
DEF[op_par,FN[[],80]]
DEF[op_seq,FN[[],81]]

DEF[is_binop,FN[[name:string],
  OR[EQ[name,'ADD'],OR[EQ[name,'SUB'],OR[EQ[name,'MUL'],OR[EQ[name,'DIV'],OR[EQ[name,'MOD'],OR[EQ[name,'EQ'],OR[EQ[name,'NE'],OR[EQ[name,'LT'],OR[EQ[name,'LE'],OR[EQ[name,'GT'],EQ[name,'GE']]]]]]]]]]]
]]

DEF[binop_code,FN[[name:string],
  IF[EQ[name,'ADD'],op_add[],
  IF[EQ[name,'SUB'],op_sub[],
  IF[EQ[name,'MUL'],op_mul[],
  IF[EQ[name,'DIV'],op_div[],
  IF[EQ[name,'MOD'],op_mod[],
  IF[EQ[name,'EQ'],op_eq[],
  IF[EQ[name,'NE'],op_ne[],
  IF[EQ[name,'LT'],op_lt[],
  IF[EQ[name,'LE'],op_le[],
  IF[EQ[name,'GT'],op_gt[],
  IF[EQ[name,'GE'],op_ge[],
  0]]]]]]]]]]]
]]

DEF[is_native,FN[[name:string],
  OR[EQ[name,'LEN'],OR[EQ[name,'AT'],OR[EQ[name,'SLICE'],OR[EQ[name,'CONCAT'],OR[EQ[name,'APPEND'],OR[EQ[name,'LIST'],OR[EQ[name,'CODEPOINT'],OR[EQ[name,'FROM_CODEPOINT'],OR[EQ[name,'MAP_NEW'],OR[EQ[name,'MAP_GET'],OR[EQ[name,'MAP_SET'],OR[EQ[name,'SUM'],OR[EQ[name,'TAG'],OR[EQ[name,'PAYLOAD'],OR[EQ[name,'FS_READ'],OR[EQ[name,'FS_WRITE'],OR[EQ[name,'PRINT'],OR[EQ[name,'BYTES_FROM_STRING'],OR[EQ[name,'STRING_FROM_BYTES'],OR[EQ[name,'FLOAT_FROM_STRING'],OR[EQ[name,'ERR_MAKE'],OR[EQ[name,'UNIT'],OR[EQ[name,'REF'],OR[EQ[name,'DEREF'],EQ[name,'CALL_PROGRAM']]]]]]]]]]]]]]]]]]]]]]]]]
]]

DEF[set_at,FN[[xs,i,v],
  CONCAT[CONCAT[SLICE[xs,0,i],LIST[v]],SLICE[xs,ADD[i,1],LEN[xs]]]
]]

DEF[emit_const,FN[[code,consts,v],
  SUM['Ok',LIST[
    CONCAT[code,LIST[op_load_const[],LEN[consts]]],
    APPEND[consts,v]
  ]]
]]

DEF[loc_index,FN[[names,name,i],
  IF[GE[i,LEN[names]],
    SUM['Err',name],
    IF[EQ[AT[names,i],name],
      SUM['Ok',i],
      loc_index[names,name,ADD[i,1]]
    ]
  ]
]]

DEF[map_subst,FN[[xs,i,name,repl],
  IF[GE[i,LEN[xs]],
    LIST[],
    CONCAT[LIST[subst_var[AT[xs,i],name,repl]],map_subst[xs,ADD[i,1],name,repl]]
  ]
]]

DEF[subst_var,FN[[ast,name,repl],
  IF[EQ[TAG[ast],'Var'],
    IF[EQ[PAYLOAD[ast],name],repl,ast],
    IF[EQ[TAG[ast],'Lit'],
      ast,
      IF[EQ[TAG[ast],'StrLit'],
        ast,
        IF[EQ[TAG[ast],'Call'],
          SUM['Call',LIST[AT[PAYLOAD[ast],0],map_subst[AT[PAYLOAD[ast],1],0,name,repl]]],
          IF[EQ[TAG[ast],'Match'],
            SUM['Match',LIST[
              subst_var[AT[PAYLOAD[ast],0],name,repl],
              map_subst_cases[AT[PAYLOAD[ast],1],0,name,repl]
            ]],
            ast
          ]
        ]
      ]
    ]
  ]
]]

DEF[map_subst_cases,FN[[xs,i,name,repl],
  IF[GE[i,LEN[xs]],
    LIST[],
    MATCH[AT[xs,i],
      CASE[Case,c,
        CONCAT[
          LIST[SUM['Case',LIST[
            AT[c,0],
            AT[c,1],
            IF[EQ[AT[c,1],name],AT[c,2],subst_var[AT[c,2],name,repl]]
          ]]],
          map_subst_cases[xs,ADD[i,1],name,repl]
        ]
      ]
    ]
  ]
]]

DEF[desugar_match,FN[[scr,cases,i],
  IF[GE[i,LEN[cases]],
    SUM['Lit',0],
    MATCH[AT[cases,i],
      CASE[Case,c,
        SUM['Call',LIST['IF',LIST[
          SUM['Call',LIST['EQ',LIST[
            SUM['Call',LIST['TAG',LIST[scr]]],
            SUM['StrLit',AT[c,0]]
          ]]],
          IF[EQ[AT[c,1],''],
            AT[c,2],
            subst_var[AT[c,2],AT[c,1],SUM['Call',LIST['PAYLOAD',LIST[scr]]]]
          ],
          desugar_match[scr,cases,ADD[i,1]]
        ]]]
      ]
    ]
  ]
]]

DEF[codegen_match,FN[[scr,cases,code,consts,locs],
  MATCH[codegen[scr,code,consts,locs],
    CASE[Ok,ps,
      MATCH[codegen[
        desugar_match[SUM['Var',CONCAT['__m',FROM_CODEPOINT[ADD[65,LEN[locs]]]]],cases,0],
        CONCAT[AT[ps,0],LIST[op_store_local[],LEN[locs]]],
        AT[ps,1],
        APPEND[locs,CONCAT['__m',FROM_CODEPOINT[ADD[65,LEN[locs]]]]]
      ],
        CASE[Ok,p,SUM['Ok',p]]
      ]
    ]
  ]
]]

DEF[codegen_list,FN[[args,i,code,consts,locs],
  IF[GE[i,LEN[args]],
    SUM['Ok',LIST[code,consts]],
    MATCH[codegen[AT[args,i],code,consts,locs],
      CASE[Ok,p,
        codegen_list[args,ADD[i,1],AT[p,0],AT[p,1],locs]
      ]
    ]
  ]
]]

DEF[patch_if,FN[[before,after_then,after_else,consts],
  SUM['Ok',LIST[
    set_at[
      set_at[after_else,ADD[LEN[before],1],ADD[LEN[after_then],2]],
      ADD[LEN[after_then],1],
      LEN[after_else]
    ],
    consts
  ]]
]]

DEF[codegen_if,FN[[c,t,e,code,consts,locs],
  MATCH[codegen[c,code,consts,locs],
    CASE[Ok,pc,
      MATCH[codegen[t,CONCAT[AT[pc,0],LIST[op_jump_if_false[],0]],AT[pc,1],locs],
        CASE[Ok,pt,
          MATCH[codegen[e,CONCAT[AT[pt,0],LIST[op_jump[],0]],AT[pt,1],locs],
            CASE[Ok,pe,
              patch_if[AT[pc,0],AT[pt,0],AT[pe,0],AT[pe,1]]
            ]
          ]
        ]
      ]
    ]
  ]
]]

DEF[sum_tag_arg,FN[[a],
  IF[EQ[TAG[a],'Var'],
    SUM['StrLit',PAYLOAD[a]],
    a
  ]
]]

DEF[codegen_call,FN[[name,args,code,consts,locs],
  IF[AND[EQ[name,'SUM'],EQ[LEN[args],2]],
    MATCH[codegen_list[LIST[sum_tag_arg[AT[args,0]],AT[args,1]],0,code,consts,locs],
      CASE[Ok,p,
        SUM['Ok',LIST[
          CONCAT[AT[p,0],LIST[op_native[],LEN[AT[p,1]],2]],
          APPEND[AT[p,1],'SUM']
        ]]
      ]
    ],
    IF[OR[AND[EQ[name,'IF'],EQ[LEN[args],3]],AND[EQ[name,'COND'],EQ[LEN[args],3]]],
      codegen_if[AT[args,0],AT[args,1],AT[args,2],code,consts,locs],
      IF[AND[EQ[name,'AND'],EQ[LEN[args],2]],
        codegen_if[AT[args,0],AT[args,1],SUM['Var','false'],code,consts,locs],
        IF[AND[EQ[name,'OR'],EQ[LEN[args],2]],
          codegen_if[AT[args,0],SUM['Var','true'],AT[args,1],code,consts,locs],
          IF[AND[EQ[name,'NOT'],EQ[LEN[args],1]],
            MATCH[codegen[AT[args,0],code,consts,locs],
              CASE[Ok,a,
                SUM['Ok',LIST[APPEND[AT[a,0],op_not[]],AT[a,1]]]
              ]
            ],
            IF[AND[EQ[name,'NEG'],EQ[LEN[args],1]],
              MATCH[codegen[AT[args,0],code,consts,locs],
                CASE[Ok,a,
                  SUM['Ok',LIST[APPEND[AT[a,0],op_neg[]],AT[a,1]]]
                ]
              ],
              IF[EQ[name,'GET'],
                codegen_get[args,code,consts,locs],
                IF[EQ[name,'RECORD'],
                  codegen_record[args,code,consts,locs],
                  IF[EQ[name,'PAR'],
                    MATCH[codegen_list[args,0,code,consts,locs],
                      CASE[Ok,p,
                        SUM['Ok',LIST[CONCAT[AT[p,0],LIST[op_par[],LEN[args]]],AT[p,1]]]
                      ]
                    ],
                    IF[EQ[name,'SEQ'],
                      MATCH[codegen_list[args,0,code,consts,locs],
                        CASE[Ok,p,
                          SUM['Ok',LIST[CONCAT[AT[p,0],LIST[op_seq[],LEN[args]]],AT[p,1]]]
                        ]
                      ],
                      IF[AND[EQ[name,'REF'],EQ[LEN[args],2]],
                        MATCH[codegen[sum_tag_arg[AT[args,0]],code,consts,locs],
                          CASE[Ok,a,
                            MATCH[codegen[AT[args,1],AT[a,0],AT[a,1],locs],
                              CASE[Ok,b,
                                SUM['Ok',LIST[
                                  CONCAT[AT[b,0],LIST[op_native[],LEN[AT[b,1]],2]],
                                  APPEND[AT[b,1],'REF']
                                ]]
                              ]
                            ]
                          ]
                        ],
                        IF[AND[EQ[name,'DEREF'],EQ[LEN[args],1]],
                          MATCH[codegen[AT[args,0],code,consts,locs],
                            CASE[Ok,a,
                              SUM['Ok',LIST[
                                CONCAT[AT[a,0],LIST[op_native[],LEN[AT[a,1]],1]],
                                APPEND[AT[a,1],'DEREF']
                              ]]
                            ]
                          ],
                          IF[EQ[name,'INVOKE'],
                            MATCH[codegen[SUM['Call',LIST['ERR_MAKE',LIST[SUM['StrLit','invoke_host_only']]]],code,consts,locs],
                              CASE[Ok,p,SUM['Ok',p]]
                            ],
                            IF[EQ[name,'UNSAFE'],
                              IF[GE[LEN[args],1],
                                codegen[AT[args,SUB[LEN[args],1]],code,consts,locs],
                                SUM['Err','unsafe']
                              ],
                              IF[AND[is_binop[name],EQ[LEN[args],2]],
                                MATCH[codegen[AT[args,0],code,consts,locs],
                                  CASE[Ok,a,
                                    MATCH[codegen[AT[args,1],AT[a,0],AT[a,1],locs],
                                      CASE[Ok,b,
                                        SUM['Ok',LIST[APPEND[AT[b,0],binop_code[name]],AT[b,1]]]
                                      ]
                                    ]
                                  ]
                                ],
                                IF[is_native[name],
                                  MATCH[codegen_list[args,0,code,consts,locs],
                                    CASE[Ok,p,
                                      SUM['Ok',LIST[
                                        CONCAT[AT[p,0],LIST[op_native[],LEN[AT[p,1]],LEN[args]]],
                                        APPEND[AT[p,1],name]
                                      ]]
                                    ]
                                  ],
                                  MATCH[codegen_list[args,0,code,consts,locs],
                                    CASE[Ok,p,
                                      SUM['Ok',LIST[
                                        CONCAT[AT[p,0],LIST[op_call[],LEN[AT[p,1]],LEN[args]]],
                                        APPEND[AT[p,1],name]
                                      ]]
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ]
      ]
    ]
  ]
]]

DEF[field_key,FN[[k],
  IF[EQ[TAG[k],'Var'],
    SUM['StrLit',PAYLOAD[k]],
    IF[EQ[TAG[k],'StrLit'],
      k,
      k
    ]
  ]
]]

DEF[flatten_record,FN[[args,i,acc],
  IF[GE[i,LEN[args]],
    acc,
    IF[EQ[i,0],
      flatten_record[args,1,APPEND[acc,AT[args,0]]],
      IF[AND[EQ[TAG[AT[args,i]],'Call'],EQ[AT[PAYLOAD[AT[args,i]],0],'FIELD']],
        flatten_record[args,ADD[i,1],CONCAT[acc,LIST[
          field_key[AT[AT[PAYLOAD[AT[args,i]],1],0]],
          AT[AT[PAYLOAD[AT[args,i]],1],1]
        ]]],
        SUM['Err','record_field']
      ]
    ]
  ]
]]

DEF[codegen_record,FN[[args,code,consts,locs],
  IF[EQ[TAG[flatten_record[args,0,LIST[]]],'Err'],
    flatten_record[args,0,LIST[]],
    MATCH[codegen_list[flatten_record[args,0,LIST[]],0,code,consts,locs],
      CASE[Ok,p,
        SUM['Ok',LIST[
          CONCAT[AT[p,0],LIST[op_native[],LEN[AT[p,1]],LEN[flatten_record[args,0,LIST[]]]]],
          APPEND[AT[p,1],'RECORD']
        ]]
      ]
    ]
  ]
]]

DEF[codegen_get,FN[[args,code,consts,locs],
  IF[EQ[LEN[args],2],
    MATCH[codegen_list[LIST[AT[args,0],field_key[AT[args,1]]],0,code,consts,locs],
      CASE[Ok,p,
        SUM['Ok',LIST[
          CONCAT[AT[p,0],LIST[op_native[],LEN[AT[p,1]],2]],
          APPEND[AT[p,1],'GET']
        ]]
      ]
    ],
    SUM['Err','get_arity']
  ]
]]

DEF[codegen,FN[[ast,code,consts,locs],
  IF[EQ[TAG[ast],'Lit'],
    emit_const[code,consts,PAYLOAD[ast]],
    IF[EQ[TAG[ast],'StrLit'],
      emit_const[code,consts,PAYLOAD[ast]],
      IF[EQ[TAG[ast],'TypedLit'],
        emit_const[code,consts,AT[PAYLOAD[ast],0]],
        IF[EQ[TAG[ast],'FloatLit'],
          MATCH[codegen[SUM['Call',LIST['FLOAT_FROM_STRING',LIST[SUM['StrLit',PAYLOAD[ast]]]]],code,consts,locs],
            CASE[Ok,p,SUM['Ok',p]]
          ],
          IF[EQ[TAG[ast],'Unit'],
            MATCH[codegen[SUM['Call',LIST['UNIT',LIST[]]],code,consts,locs],
              CASE[Ok,p,SUM['Ok',p]]
            ],
            IF[EQ[TAG[ast],'Hole'],
              SUM['Ok',LIST[APPEND[code,op_hole_trap[]],consts]],
              IF[EQ[TAG[ast],'ErrAst'],
                MATCH[codegen[SUM['Call',LIST['ERR_MAKE',IF[EQ[LEN[PAYLOAD[ast]],0],LIST[SUM['StrLit','ERR']],IF[EQ[TAG[AT[PAYLOAD[ast],0]],'Var'],LIST[SUM['StrLit',PAYLOAD[AT[PAYLOAD[ast],0]]]],PAYLOAD[ast]]]]],code,consts,locs],
                  CASE[Ok,p,SUM['Ok',p]]
                ],
                IF[EQ[TAG[ast],'Var'],
                  IF[EQ[PAYLOAD[ast],'true'],
                    emit_const[code,consts,true],
                    IF[EQ[PAYLOAD[ast],'false'],
                      emit_const[code,consts,false],
                      MATCH[loc_index[locs,PAYLOAD[ast],0],
                        CASE[Ok,idx,
                          SUM['Ok',LIST[
                            CONCAT[code,LIST[op_load_local[],idx]],
                            consts
                          ]]
                        ],
                        CASE[Err,n,SUM['Err',CONCAT['unbound:',n]]]
                      ]
                    ]
                  ],
                  IF[EQ[TAG[ast],'Match'],
                    codegen_match[AT[PAYLOAD[ast],0],AT[PAYLOAD[ast],1],code,consts,locs],
                    IF[EQ[TAG[ast],'Call'],
                      codegen_call[AT[PAYLOAD[ast],0],AT[PAYLOAD[ast],1],code,consts,locs],
                      IF[EQ[TAG[ast],'Fn'],
                        SUM['Err','bare_fn'],
                        SUM['Err','bad_ast']
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ]
      ]
    ]
  ]
]]

DEF[param_names,FN[[params,i],
  IF[GE[i,LEN[params]],
    LIST[],
    CONCAT[LIST[PAYLOAD[AT[params,i]]],param_names[params,ADD[i,1]]]
  ]
]]

DEF[codegen_fn,FN[[fn],
  MATCH[fn,
    CASE[Fn,pack,
      MATCH[codegen[AT[pack,1],LIST[],LIST[],param_names[AT[pack,0],0]],
        CASE[Ok,p,
          SUM['Ok',LIST[APPEND[AT[p,0],op_return[]],AT[p,1],LEN[AT[pack,0]]]]
        ]
      ]
    ]
  ]
]]

DEF[is_skip_item,FN[[t],
  OR[EQ[t,'Import'],OR[EQ[t,'Export'],OR[EQ[t,'TEST'],OR[EQ[t,'PROPERTY'],OR[EQ[t,'DEPENDS'],OR[EQ[t,'MODEL'],OR[EQ[t,'TOOL'],OR[EQ[t,'VERSION'],EQ[t,'EXPORT']]]]]]]]]
]]

DEF[codegen_prog,FN[[items,i,funcs],
  IF[GE[i,LEN[items]],
    SUM['Program',funcs],
    IF[EQ[TAG[AT[items,i]],'Def'],
      MATCH[codegen_fn[AT[PAYLOAD[AT[items,i]],1]],
        CASE[Ok,f,
          codegen_prog[items,ADD[i,1],APPEND[funcs,SUM['Func',LIST[
            AT[PAYLOAD[AT[items,i]],0],
            AT[f,2],
            AT[f,0],
            AT[f,1]
          ]]]]
        ]
      ],
      IF[EQ[TAG[AT[items,i]],'Main'],
        MATCH[codegen[PAYLOAD[AT[items,i]],LIST[],LIST[],LIST[]],
          CASE[Ok,p,
            codegen_prog[items,ADD[i,1],APPEND[funcs,SUM['Func',LIST[
              '__main',
              0,
              APPEND[AT[p,0],op_return[]],
              AT[p,1]
            ]]]]
          ]
        ],
        IF[EQ[TAG[AT[items,i]],'Module'],
          codegen_prog[CONCAT[AT[PAYLOAD[AT[items,i]],1],SLICE[items,ADD[i,1],LEN[items]]],0,funcs],
          IF[is_skip_item[TAG[AT[items,i]]],
            codegen_prog[items,ADD[i,1],funcs],
            SUM['Err','prog_item']
          ]
        ]
      ]
    ]
  ]
]]

DEF[compile_ast,FN[[ast],
  IF[EQ[TAG[ast],'Prog'],
    codegen_prog[PAYLOAD[ast],0,LIST[]],
    MATCH[codegen[ast,LIST[],LIST[],LIST[]],
      CASE[Ok,pack,
        SUM['Program',LIST[SUM['Func',LIST['__main',0,APPEND[AT[pack,0],op_return[]],AT[pack,1]]]]]
      ],
      CASE[Err,e,SUM['Err',e]]
    ]
  ]
]]
