DEF[parse_type_name,FN[[toks,i],
  IF[EQ[TAG[AT[toks,i]],'Ident'],
    IF[AND[LT[ADD[i,1],LEN[toks]],EQ[TAG[AT[toks,ADD[i,1]]],'At']],
      IF[EQ[TAG[AT[toks,ADD[i,2]]],'Ident'],
        SUM['Ok',LIST[ADD[i,3],CONCAT[CONCAT[PAYLOAD[AT[toks,i]],'@'],PAYLOAD[AT[toks,ADD[i,2]]]]]],
        SUM['Err','type_at']
      ],
      SUM['Ok',LIST[ADD[i,1],PAYLOAD[AT[toks,i]]]]
    ],
    SUM['Err','type']
  ]
]]

DEF[parse_expr,FN[[toks,i],
  IF[EQ[TAG[AT[toks,i]],'Hole'],
    IF[AND[LT[ADD[i,1],LEN[toks]],EQ[TAG[AT[toks,ADD[i,1]]],'Colon']],
      MATCH[parse_type_name[toks,ADD[i,2]],
        CASE[Ok,t,
          SUM['Ok',LIST[AT[t,0],SUM['Hole',AT[t,1]]]]
        ]
      ],
      SUM['Ok',LIST[ADD[i,1],SUM['Hole','']]]
    ],
    IF[EQ[TAG[AT[toks,i]],'Minus'],
      MATCH[parse_expr[toks,ADD[i,1]],
        CASE[Ok,e,
          SUM['Ok',LIST[AT[e,0],SUM['Call',LIST['NEG',LIST[AT[e,1]]]]]]
        ]
      ],
      IF[EQ[TAG[AT[toks,i]],'Num'],
        parse_num_or_typed[toks,i],
        IF[EQ[TAG[AT[toks,i]],'Float'],
          parse_float_or_typed[toks,i],
          IF[EQ[TAG[AT[toks,i]],'Str'],
            parse_str_or_typed[toks,i],
            IF[EQ[TAG[AT[toks,i]],'Ident'],
              parse_ident_expr[toks,i],
              SUM['Err','bad_expr']
            ]
          ]
        ]
      ]
    ]
  ]
]]

DEF[parse_num_or_typed,FN[[toks,i],
  IF[AND[LT[ADD[i,1],LEN[toks]],EQ[TAG[AT[toks,ADD[i,1]]],'Colon']],
    MATCH[parse_type_name[toks,ADD[i,2]],
      CASE[Ok,t,
        SUM['Ok',LIST[AT[t,0],SUM['TypedLit',LIST[PAYLOAD[AT[toks,i]],AT[t,1]]]]]
      ]
    ],
    SUM['Ok',LIST[ADD[i,1],SUM['Lit',PAYLOAD[AT[toks,i]]]]]
  ]
]]

DEF[parse_float_or_typed,FN[[toks,i],
  IF[AND[LT[ADD[i,1],LEN[toks]],EQ[TAG[AT[toks,ADD[i,1]]],'Colon']],
    MATCH[parse_type_name[toks,ADD[i,2]],
      CASE[Ok,t,
        SUM['Ok',LIST[AT[t,0],SUM['FloatLit',PAYLOAD[AT[toks,i]]]]]
      ]
    ],
    SUM['Ok',LIST[ADD[i,1],SUM['FloatLit',PAYLOAD[AT[toks,i]]]]]
  ]
]]

DEF[parse_str_or_typed,FN[[toks,i],
  IF[AND[LT[ADD[i,1],LEN[toks]],EQ[TAG[AT[toks,ADD[i,1]]],'Colon']],
    MATCH[parse_type_name[toks,ADD[i,2]],
      CASE[Ok,t,
        SUM['Ok',LIST[AT[t,0],SUM['StrLit',PAYLOAD[AT[toks,i]]]]]
      ]
    ],
    SUM['Ok',LIST[ADD[i,1],SUM['StrLit',PAYLOAD[AT[toks,i]]]]]
  ]
]]

DEF[parse_ident_expr,FN[[toks,i],
  IF[EQ[PAYLOAD[AT[toks,i]],'MATCH'],
    parse_match[toks,i],
    IF[EQ[PAYLOAD[AT[toks,i]],'FN'],
      parse_fn[toks,i],
      IF[EQ[PAYLOAD[AT[toks,i]],'ERR'],
        parse_err[toks,i],
        IF[OR[EQ[PAYLOAD[AT[toks,i]],'unit'],EQ[PAYLOAD[AT[toks,i]],'UNIT']],
          SUM['Ok',LIST[ADD[i,1],SUM['Unit',0]]],
          IF[EQ[PAYLOAD[AT[toks,i]],'nil'],
            SUM['Ok',LIST[ADD[i,1],SUM['Unit',0]]],
            IF[AND[LT[ADD[i,1],LEN[toks]],EQ[TAG[AT[toks,ADD[i,1]]],'LBrack']],
              MATCH[parse_arglist[toks,ADD[i,2]],
                CASE[Ok,pack,
                  SUM['Ok',LIST[AT[pack,0],SUM['Call',LIST[PAYLOAD[AT[toks,i]],AT[pack,1]]]]]]
              ],
              SUM['Ok',LIST[ADD[i,1],SUM['Var',PAYLOAD[AT[toks,i]]]]]
            ]
          ]
        ]
      ]
    ]
  ]
]]

DEF[parse_err,FN[[toks,i],
  IF[EQ[TAG[AT[toks,ADD[i,1]]],'LBrack'],
    MATCH[parse_arglist[toks,ADD[i,2]],
      CASE[Ok,pack,
        SUM['Ok',LIST[AT[pack,0],SUM['ErrAst',AT[pack,1]]]]
      ]
    ],
    SUM['Err','err']
  ]
]]

DEF[parse_arglist,FN[[toks,i],
  IF[EQ[TAG[AT[toks,i]],'RBrack'],
    SUM['Ok',LIST[ADD[i,1],LIST[]]],
    MATCH[parse_expr[toks,i],
      CASE[Ok,first,
        IF[EQ[TAG[AT[toks,AT[first,0]]],'RBrack'],
          SUM['Ok',LIST[ADD[AT[first,0],1],LIST[AT[first,1]]]],
          IF[EQ[TAG[AT[toks,AT[first,0]]],'Comma'],
            MATCH[parse_arglist[toks,ADD[AT[first,0],1]],
              CASE[Ok,rest,
                SUM['Ok',LIST[AT[rest,0],CONCAT[LIST[AT[first,1]],AT[rest,1]]]]]
            ],
            SUM['Err','arglist']
          ]
        ]
      ]
    ]
  ]
]]

DEF[parse_param,FN[[toks,i],
  IF[EQ[TAG[AT[toks,i]],'Ident'],
    IF[AND[LT[ADD[i,1],LEN[toks]],EQ[TAG[AT[toks,ADD[i,1]]],'Colon']],
      MATCH[parse_type_name[toks,ADD[i,2]],
        CASE[Ok,t,
          SUM['Ok',LIST[AT[t,0],SUM['Param',PAYLOAD[AT[toks,i]]]]]
        ]
      ],
      SUM['Ok',LIST[ADD[i,1],SUM['Param',PAYLOAD[AT[toks,i]]]]]
    ],
    SUM['Err','param']
  ]
]]

DEF[parse_params,FN[[toks,i],
  IF[EQ[TAG[AT[toks,i]],'RBrack'],
    SUM['Ok',LIST[ADD[i,1],LIST[]]],
    MATCH[parse_param[toks,i],
      CASE[Ok,first,
        IF[EQ[TAG[AT[toks,AT[first,0]]],'RBrack'],
          SUM['Ok',LIST[ADD[AT[first,0],1],LIST[AT[first,1]]]],
          IF[EQ[TAG[AT[toks,AT[first,0]]],'Comma'],
            MATCH[parse_params[toks,ADD[AT[first,0],1]],
              CASE[Ok,rest,
                SUM['Ok',LIST[AT[rest,0],CONCAT[LIST[AT[first,1]],AT[rest,1]]]]]
            ],
            SUM['Err','params']
          ]
        ]
      ]
    ]
  ]
]]

DEF[parse_fn,FN[[toks,i],
  IF[AND[EQ[TAG[AT[toks,i]],'Ident'],EQ[PAYLOAD[AT[toks,i]],'FN']],
    IF[EQ[TAG[AT[toks,ADD[i,1]]],'LBrack'],
      IF[EQ[TAG[AT[toks,ADD[i,2]]],'LBrack'],
        MATCH[parse_params[toks,ADD[i,3]],
          CASE[Ok,ps,
            IF[EQ[TAG[AT[toks,AT[ps,0]]],'Comma'],
              MATCH[parse_expr[toks,ADD[AT[ps,0],1]],
                CASE[Ok,body,
                  IF[EQ[TAG[AT[toks,AT[body,0]]],'RBrack'],
                    SUM['Ok',LIST[ADD[AT[body,0],1],SUM['Fn',LIST[AT[ps,1],AT[body,1]]]]],
                    SUM['Err','fn_rbrack']
                  ]
                ]
              ],
              SUM['Err','fn_comma']
            ]
          ]
        ],
        SUM['Err','fn_params']
      ],
      SUM['Err','fn_lbrack']
    ],
    SUM['Err','fn']
  ]
]]

DEF[parse_def,FN[[toks,i],
  IF[AND[EQ[TAG[AT[toks,i]],'Ident'],EQ[PAYLOAD[AT[toks,i]],'DEF']],
    IF[EQ[TAG[AT[toks,ADD[i,1]]],'LBrack'],
      IF[EQ[TAG[AT[toks,ADD[i,2]]],'Ident'],
        IF[EQ[TAG[AT[toks,ADD[i,3]]],'Comma'],
          IF[AND[EQ[TAG[AT[toks,ADD[i,4]]],'Ident'],EQ[PAYLOAD[AT[toks,ADD[i,4]]],'FN']],
            MATCH[parse_fn[toks,ADD[i,4]],
              CASE[Ok,fn,
                IF[EQ[TAG[AT[toks,AT[fn,0]]],'RBrack'],
                  SUM['Ok',LIST[ADD[AT[fn,0],1],SUM['Def',LIST[PAYLOAD[AT[toks,ADD[i,2]]],AT[fn,1]]]]],
                  SUM['Err','def_rbrack']
                ]
              ]
            ],
            MATCH[parse_expr[toks,ADD[i,4]],
              CASE[Ok,body,
                IF[EQ[TAG[AT[toks,AT[body,0]]],'RBrack'],
                  SUM['Ok',LIST[ADD[AT[body,0],1],SUM['Def',LIST[PAYLOAD[AT[toks,ADD[i,2]]],SUM['Fn',LIST[LIST[],AT[body,1]]]]]]],
                  SUM['Err','def_const']
                ]
              ]
            ]
          ],
          SUM['Err','def_comma']
        ],
        SUM['Err','def_name']
      ],
      SUM['Err','def_lbrack']
    ],
    SUM['Err','def']
  ]
]]

DEF[parse_case,FN[[toks,i],
  IF[AND[EQ[TAG[AT[toks,i]],'Ident'],EQ[PAYLOAD[AT[toks,i]],'CASE']],
    IF[EQ[TAG[AT[toks,ADD[i,1]]],'LBrack'],
      IF[OR[EQ[TAG[AT[toks,ADD[i,2]]],'Ident'],EQ[TAG[AT[toks,ADD[i,2]]],'Str']],
        IF[EQ[TAG[AT[toks,ADD[i,3]]],'Comma'],
          MATCH[parse_expr[toks,ADD[i,4]],
            CASE[Ok,a,
              IF[EQ[TAG[AT[toks,AT[a,0]]],'RBrack'],
                SUM['Ok',LIST[ADD[AT[a,0],1],SUM['Case',LIST[PAYLOAD[AT[toks,ADD[i,2]]],'',AT[a,1]]]]],
                IF[AND[EQ[TAG[AT[toks,AT[a,0]]],'Comma'],EQ[TAG[AT[a,1]],'Var']],
                  MATCH[parse_expr[toks,ADD[AT[a,0],1]],
                    CASE[Ok,b,
                      IF[EQ[TAG[AT[toks,AT[b,0]]],'RBrack'],
                        SUM['Ok',LIST[ADD[AT[b,0],1],SUM['Case',LIST[PAYLOAD[AT[toks,ADD[i,2]]],PAYLOAD[AT[a,1]],AT[b,1]]]]],
                        SUM['Err','case_end']
                      ]
                    ]
                  ],
                  SUM['Err','case']
                ]
              ]
            ]
          ],
          SUM['Err','case_comma']
        ],
        SUM['Err','case_tag']
      ],
      SUM['Err','case_lbrack']
    ],
    SUM['Err','case']
  ]
]]

DEF[parse_cases,FN[[toks,i],
  IF[EQ[TAG[AT[toks,i]],'RBrack'],
    SUM['Ok',LIST[ADD[i,1],LIST[]]],
    MATCH[parse_case[toks,i],
      CASE[Ok,first,
        IF[EQ[TAG[AT[toks,AT[first,0]]],'RBrack'],
          SUM['Ok',LIST[ADD[AT[first,0],1],LIST[AT[first,1]]]],
          IF[EQ[TAG[AT[toks,AT[first,0]]],'Comma'],
            MATCH[parse_cases[toks,ADD[AT[first,0],1]],
              CASE[Ok,rest,
                SUM['Ok',LIST[AT[rest,0],CONCAT[LIST[AT[first,1]],AT[rest,1]]]]]
            ],
            SUM['Err','cases']
          ]
        ]
      ]
    ]
  ]
]]

DEF[parse_match,FN[[toks,i],
  IF[EQ[TAG[AT[toks,ADD[i,1]]],'LBrack'],
    MATCH[parse_expr[toks,ADD[i,2]],
      CASE[Ok,scr,
        IF[EQ[TAG[AT[toks,AT[scr,0]]],'Comma'],
          MATCH[parse_cases[toks,ADD[AT[scr,0],1]],
            CASE[Ok,cs,
              SUM['Ok',LIST[AT[cs,0],SUM['Match',LIST[AT[scr,1],AT[cs,1]]]]]
            ]
          ],
          SUM['Err','match_comma']
        ]
      ]
    ],
    SUM['Err','match']
  ]
]]

DEF[parse_toplevel,FN[[toks,i],
  IF[EQ[TAG[AT[toks,i]],'Eof'],
    SUM['Ok',LIST[i,LIST[]]],
    IF[AND[EQ[TAG[AT[toks,i]],'Ident'],EQ[PAYLOAD[AT[toks,i]],'DEF']],
      MATCH[parse_def[toks,i],
        CASE[Ok,d,
          MATCH[parse_toplevel[toks,AT[d,0]],
            CASE[Ok,rest,
              SUM['Ok',LIST[AT[rest,0],CONCAT[LIST[AT[d,1]],AT[rest,1]]]]]
          ]
        ]
      ],
      IF[AND[EQ[TAG[AT[toks,i]],'Ident'],EQ[PAYLOAD[AT[toks,i]],'IMPORT']],
        MATCH[parse_import[toks,i],
          CASE[Ok,im,
            MATCH[parse_toplevel[toks,AT[im,0]],
              CASE[Ok,rest,
                SUM['Ok',LIST[AT[rest,0],CONCAT[LIST[AT[im,1]],AT[rest,1]]]]]
            ]
          ]
        ],
        IF[AND[EQ[TAG[AT[toks,i]],'Ident'],EQ[PAYLOAD[AT[toks,i]],'MODULE']],
          MATCH[parse_module[toks,i],
            CASE[Ok,m,
              MATCH[parse_toplevel[toks,AT[m,0]],
                CASE[Ok,rest,
                  SUM['Ok',LIST[AT[rest,0],CONCAT[LIST[AT[m,1]],AT[rest,1]]]]]
              ]
            ]
          ],
          IF[AND[EQ[TAG[AT[toks,i]],'Ident'],OR[EQ[PAYLOAD[AT[toks,i]],'TEST'],EQ[PAYLOAD[AT[toks,i]],'PROPERTY']]],
            MATCH[parse_test_or_prop[toks,i],
              CASE[Ok,t,
                MATCH[parse_toplevel[toks,AT[t,0]],
                  CASE[Ok,rest,
                    SUM['Ok',LIST[AT[rest,0],CONCAT[LIST[AT[t,1]],AT[rest,1]]]]]
                ]
              ]
            ],
            IF[AND[EQ[TAG[AT[toks,i]],'Ident'],OR[EQ[PAYLOAD[AT[toks,i]],'DEPENDS'],OR[EQ[PAYLOAD[AT[toks,i]],'MODEL'],OR[EQ[PAYLOAD[AT[toks,i]],'TOOL'],OR[EQ[PAYLOAD[AT[toks,i]],'VERSION'],EQ[PAYLOAD[AT[toks,i]],'EXPORT']]]]]],
              MATCH[parse_stub_form[toks,i,PAYLOAD[AT[toks,i]]],
                CASE[Ok,st,
                  MATCH[parse_toplevel[toks,AT[st,0]],
                    CASE[Ok,rest,
                      SUM['Ok',LIST[AT[rest,0],CONCAT[LIST[AT[st,1]],AT[rest,1]]]]]
                  ]
                ]
              ],
              MATCH[parse_expr[toks,i],
                CASE[Ok,e,
                  SUM['Ok',LIST[AT[e,0],LIST[SUM['Main',AT[e,1]]]]]
                ]
              ]
            ]
          ]
        ]
      ]
    ]
  ]
]]

DEF[skip_brackets,FN[[toks,i,depth],
  IF[GE[i,LEN[toks]],
    SUM['Err','unclosed'],
    IF[EQ[TAG[AT[toks,i]],'LBrack'],
      skip_brackets[toks,ADD[i,1],ADD[depth,1]],
      IF[EQ[TAG[AT[toks,i]],'RBrack'],
        IF[LE[depth,1],
          SUM['Ok',ADD[i,1]],
          skip_brackets[toks,ADD[i,1],SUB[depth,1]]
        ],
        skip_brackets[toks,ADD[i,1],depth]
      ]
    ]
  ]
]]

DEF[parse_stub_form,FN[[toks,i,tag],
  IF[EQ[TAG[AT[toks,ADD[i,1]]],'LBrack'],
    MATCH[skip_brackets[toks,ADD[i,2],1],
      CASE[Ok,j,SUM['Ok',LIST[j,SUM[tag,PAYLOAD[AT[toks,i]]]]]]
    ],
    SUM['Err','stub']
  ]
]]

DEF[parse_import,FN[[toks,i],
  IF[EQ[TAG[AT[toks,ADD[i,1]]],'LBrack'],
    IF[OR[EQ[TAG[AT[toks,ADD[i,2]]],'Str'],EQ[TAG[AT[toks,ADD[i,2]]],'Ident']],
      IF[EQ[TAG[AT[toks,ADD[i,3]]],'RBrack'],
        SUM['Ok',LIST[ADD[i,4],SUM['Import',LIST[PAYLOAD[AT[toks,ADD[i,2]]],LIST[]]]]],
        IF[EQ[TAG[AT[toks,ADD[i,3]]],'Comma'],
          MATCH[parse_import_names[toks,ADD[i,4],LIST[]],
            CASE[Ok,pack,
              SUM['Ok',LIST[AT[pack,0],SUM['Import',LIST[PAYLOAD[AT[toks,ADD[i,2]]],AT[pack,1]]]]]
            ]
          ],
          SUM['Err','import_end']
        ]
      ],
      SUM['Err','import_name']
    ],
    SUM['Err','import']
  ]
]]

DEF[parse_import_names,FN[[toks,i,acc],
  IF[EQ[TAG[AT[toks,i]],'RBrack'],
    SUM['Ok',LIST[ADD[i,1],acc]],
    IF[EQ[TAG[AT[toks,i]],'Ident'],
      IF[EQ[TAG[AT[toks,ADD[i,1]]],'Comma'],
        parse_import_names[toks,ADD[i,2],APPEND[acc,PAYLOAD[AT[toks,i]]]],
        IF[EQ[TAG[AT[toks,ADD[i,1]]],'RBrack'],
          SUM['Ok',LIST[ADD[i,2],APPEND[acc,PAYLOAD[AT[toks,i]]]]],
          SUM['Err','import_names']
        ]
      ],
      SUM['Err','import_names']
    ]
  ]
]]

DEF[parse_module,FN[[toks,i],
  IF[EQ[TAG[AT[toks,ADD[i,1]]],'LBrack'],
    IF[EQ[TAG[AT[toks,ADD[i,2]]],'Ident'],
      MATCH[parse_module_body[toks,ADD[i,3],LIST[]],
        CASE[Ok,pack,
          SUM['Ok',LIST[AT[pack,0],SUM['Module',LIST[PAYLOAD[AT[toks,ADD[i,2]]],AT[pack,1]]]]]
        ]
      ],
      SUM['Err','module_name']
    ],
    SUM['Err','module']
  ]
]]

DEF[parse_module_body,FN[[toks,i,acc],
  IF[EQ[TAG[AT[toks,i]],'RBrack'],
    SUM['Ok',LIST[ADD[i,1],acc]],
    IF[EQ[TAG[AT[toks,i]],'Comma'],
      parse_module_body[toks,ADD[i,1],acc],
      IF[AND[EQ[TAG[AT[toks,i]],'Ident'],EQ[PAYLOAD[AT[toks,i]],'DEF']],
        MATCH[parse_def[toks,i],
          CASE[Ok,d,
            parse_module_body[toks,AT[d,0],APPEND[acc,AT[d,1]]]
          ]
        ],
        IF[AND[EQ[TAG[AT[toks,i]],'Ident'],EQ[PAYLOAD[AT[toks,i]],'EXPORT']],
          MATCH[parse_arglist[toks,ADD[i,2]],
            CASE[Ok,ex,
              parse_module_body[toks,AT[ex,0],APPEND[acc,SUM['Export',AT[ex,1]]]]
            ]
          ],
          SUM['Err','module_item']
        ]
      ]
    ]
  ]
]]

DEF[parse_test_or_prop,FN[[toks,i],
  IF[EQ[TAG[AT[toks,ADD[i,1]]],'LBrack'],
    MATCH[parse_arglist[toks,ADD[i,2]],
      CASE[Ok,pack,
        SUM['Ok',LIST[AT[pack,0],SUM[PAYLOAD[AT[toks,i]],AT[pack,1]]]]
      ]
    ],
    SUM['Err','test']
  ]
]]

DEF[parse,FN[[toks],
  MATCH[parse_toplevel[toks,0],
    CASE[Ok,pack,SUM['Prog',AT[pack,1]]],
    CASE[Err,e,SUM['Err',e]]
  ]
]]
